{
  "version": "2.1",
  "project_name": "璇玑系统",
  "dashboard_port": 3999,
  "log_rolling": {
    "max_bytes": 5242880,
    "backup": 3
  },
  "admin": {
    "username": "admin",
    "password": "admin123"
  },
  "services": {
    "api": {
      "name": "API 后端服务",
      "description": "璇玑系统核心 API 服务（Node 自研路由器 + 23 路由域 + 16 模块 + 多引擎）",
      "port": 3010,
      "health_check": "/health",
      "cwd": "platform/backend-node",
      "command": "node src/api-server.js",
      "args": ["node", "src/api-server.js"],
      "binary_requires": ["node", "npm"],
      "npm_deps": true,
      "is_admin_only": true,
      "auto_start": false,
      "restart_delay": 3,
      "wait_time": 10,
      "startup_order_hint": 10,
      "depends_on": [],
      "tags": ["API", "后端", "核心"]
    },
    "frontend": {
      "name": "用户前端界面",
      "description": "Vite + Vue3 前台；通过 /api 代理到 api 服务 :3010",
      "port": 3020,
      "health_check": "/",
      "cwd": "frontend-ui",
      "command": "npm run dev",
      "args": ["npm", "run", "dev"],
      "binary_requires": ["node", "npm"],
      "npm_deps": true,
      "is_admin_only": false,
      "auto_start": false,
      "wait_time": 14,
      "startup_order_hint": 20,
      "depends_on": ["api"],
      "tags": ["前端", "用户界面", "Vite"]
    },
    "xiaobai_voice": {
      "name": "小白语音服务（ASR + TTS）",
      "description": "本地离线语音：Paraformer ASR / CosyVoice2 TTS（豆包级动听女声，Apache2）；端口 3717，供 Rust 网关 /voice/** 代理调用。AI 对话页面朗读第一层必命中；权重缺失时自动切浏览器拟人音兜底。",
      "port": 3717,
      "health_check": "/voice/health",
      "cwd": "projects/xiaobai_voice",
      "command": "python -m xiaobai_voice serve --host 0.0.0.0",
      "args": ["python", "-m", "xiaobai_voice", "serve", "--host", "0.0.0.0"],
      "binary_requires": ["python"],
      "npm_deps": false,
      "is_admin_only": false,
      "auto_start": true,
      "restart_delay": 3,
      "wait_time": 12,
      "startup_order_hint": 5,
      "depends_on": [],
      "tags": ["语音", "AI交互", "TTS", "ASR", "本地推理"]
    }
  }
}
