{
  "version": "2.0",
  "project_name": "璇玑系统",
  "dashboard_port": 3040,
  "admin": {
    "username": "admin",
    "password": "admin123"
  },
  "services": {
    "api": {
      "name": "API 后端服务",
      "description": "璇玑系统核心 API 服务",
      "port": 3010,
      "health_check": "/health",
      "cwd": "platform/backend-node",
      "command": "node src/api-server.js",
      "npm_deps": true,
      "is_admin_only": true,
      "auto_start": true,
      "restart_delay": 3,
      "wait_time": 5,
      "tags": [
        "API",
        "后端",
        "核心"
      ]
    },
    "frontend": {
      "name": "用户前端界面",
      "description": "面向终端用户的操作界面（含系统管理区 /admin）",
      "port": 3020,
      "health_check": "/",
      "cwd": "frontend-ui",
      "command": "npm run dev",
      "npm_deps": true,
      "is_admin_only": false,
      "auto_start": true,
      "wait_time": 8,
      "tags": [
        "前端",
        "用户界面",
        "Vite"
      ]
    }
  }
}