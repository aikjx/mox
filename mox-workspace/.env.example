# Mox Platform Configuration
MOX_SERVER_HOST=0.0.0.0
MOX_SERVER_PORT=8080
MOX_GRPC_PORT=50051

# Database
MOX_DATABASE_URL=postgres://mox:mox@localhost:5432/mox
MOX_DB_MAX_CONNECTIONS=20

# Redis
MOX_REDIS_URL=redis://localhost:6379/0

# Logging
RUST_LOG=info
MOX_LOG_LEVEL=info

# Tenant
MOX_TENANT_ID=default

# AI
MOX_AI_PROVIDER=local
MOX_AI_LOCAL_BASE_URL=http://localhost:8000

# Observability
MOX_TRACING_ENABLED=false
MOX_METRICS_ENABLED=true
