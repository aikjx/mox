# LLM 推理服务配置示例
# 复制为 .env 并修改

# 服务配置
SERVICE_NAME=mox-llm-inference-svc
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO

# 默认提供商: openai / azure / ollama / qwen / doubao
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5

# OpenAI 兼容配置
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=

# Ollama 本地模型
OLLAMA_BASE_URL=http://localhost:11434

# 通义千问
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 豆包
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 服务自身 API Key（Rust 侧调用时使用，留空则不鉴权）
SERVICE_API_KEY=

# 限流
MAX_RPM=60
MAX_CONCURRENT=10
REQUEST_TIMEOUT=60
