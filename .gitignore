# ============================================================
# MOX Platform .gitignore — 架构-数据分离规范
# 原则：源码入库，运行时数据不入库；配置模板入库，密钥不入库
# ============================================================

# ---- 运行时数据目录（架构-数据分离，绝不入库）----
/data/              # 运行时数据：storage/cache/uploads/exports
/plugins/           # 第三方插件：wasm/scripts/extensions
/.runtime/          # 运行时状态：pid/sock/lock
/artifacts/         # 运行时制品：构建/测试/语音生成产物
/exports/           # 数据导出产物
/third_party/       # 第三方源码暂存

# ---- 日志与临时文件 ----
*.log
*.out
*.err
logs/
/log/               # 标准产物归档目录（保留 .gitkeep 与 README）
.logs/              # 隐藏日志目录（运行时产生）
/*_log.txt
/build_fe*.log
tmp_pyinst_*.log

# ---- AI 助手与自动化运行时数据 ----
.trae/              # Trae 工作区过程数据（任务完成后归档到 docs/）
.workbuddy/         # WorkBuddy 记忆与状态
.ous/               # OUS 自动化运行时数据
.ous_smoke/         # OUS 冒烟测试运行时数据

# ---- 备份与临时文件 ----
*.bak
*.tmp
*.temp
*.swp
.DS_Store
Thumbs.db

# ---- 前端构建与测试产物 ----
node_modules/
frontend/dist/
dist/
frontend-ui/test-results/
frontend-ui/playwright-report/
/frontend-ui/build_log*.txt
/frontend-ui/*.log

# ---- Rust 构建产物 ----
/target
**target**
*.rmeta
*.d
NUL-*
ci_target
target_verify
release-pkg
build

# ---- Python 产物 ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache

# ---- 运行时数据库 ----
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
primiflow_runtime/

# ---- AI 模型权重（大文件不入库）----
*.bin
*.safetensors
*.gguf
*.onnx
*.pt
*.pth

# ---- 语音相关 ----
melody2score/audio/*.wav
melody2score/app/exports/
/projects/xiaobai_voice/models/

# ---- 工作区运行时制品 ----
workspace/artifacts/
workspace/screenshots/

# ---- OS / 编辑器 ----
.idea/
.vscode/

# ---- 本地环境与密钥（严禁入库）----
# 说明：大模型密钥与选型配置一律不得入库。
# - 环境变量载体：.env / .env.local（含各家 API Key、BASE_URL、MODEL 等）
# - 配置文件载体：backend/data/llm_config.json（承载 API Key 的供应商配置）
.env
.env.local
.env.*.local
*.pem
*.key
backend/data/llm_config.json
# 模板允许入库（不含任何真实密钥）：以 .example 结尾
!.env.example
!backend/.env.example

# ---- 运行时用户态数据（含敏感信息，不入库）----
backend/data/dialogue_sessions.json
backend/data/logs.json
backend/data/tasks.json
backend/data/automation.json
backend/data/workflows.json

# ---- 关图 CI 门禁生成物 ----
graph.json
graph.enterprise.json
guantu.req.json.tmp

# ---- AI 计量运行时数据（B-3 / 敏感用量，不入库）----
data/metering/

# ---- 其他 ----
*.mp4
**/out
**/tmp
**/tem
**/temp
outputs
target_regress
my_projects
.trae-html-share-packages
*.pid
*.sock

# ---- 根目录临时 txt（保留 README* / LICENSE* / CLAUDE* / 基线 *.json）----
/*.txt
!/README*.txt
!/LICENSE*.txt
!/CLAUDE*.txt

# ---- melody2score 构建过程 ----
/projects/melody2score/build_run*.txt
projects/melody2score/app/exports
projects/melody2score/build

# ---- 第三方代码仓库（子模块或外部管理）----
ais/*
!ais/README.md
