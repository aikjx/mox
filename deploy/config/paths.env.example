# MOX Platform Paths Configuration
# 架构-数据分离规范：所有路径通过环境变量或此文件配置
# 代码中禁止硬编码相对路径，必须使用 mox-platform-paths crate

# 项目根目录（自动检测，通常无需修改）
# MOX_ROOT=/path/to/infotopograph

# 运行时数据目录（.gitignore，不入库）
MOX_DATA_DIR=./data

# 第三方插件目录（.gitignore，不入库）
MOX_PLUGINS_DIR=./plugins

# 第三方源码/模型目录（.gitignore 或 git submodule）
MOX_THIRD_PARTY_DIR=./third_party

# 运行时状态目录（.gitignore，不入库）
MOX_RUNTIME_DIR=./.runtime

# 配置文件目录（Git 追踪）
MOX_CONFIG_DIR=./config
