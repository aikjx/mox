{
  "version": "3.0",
  "project_name": "MOX 模块化系统",
  "dashboard_port": 3999,
  "admin": {
    "username": "admin",
    "password": "REPLACE_ME"
  },
  "log_rolling": {
    "max_bytes": 5242880,
    "backup": 3
  },
  "services": {
    "api": {
      "name": "MOX 模块化网关",
      "description": "KG、KB、Cloud、IAM 的统一 API 入口",
      "port": 3080,
      "health_check": "/health",
      "cwd": ".",
      "command": "target/debug/mox-server.exe",
      "args": ["target/debug/mox-server.exe", "--port", "3080"],
      "binary_requires": [],
      "npm_deps": false,
      "is_admin_only": true,
      "auto_start": false,
      "restart_delay": 3,
      "wait_time": 8,
      "startup_order_hint": 10,
      "depends_on": [],
      "tags": ["API", "Rust", "Gateway"]
    },
    "frontend": {
      "name": "用户前端界面",
      "port": 3020,
      "health_check": "/",
      "cwd": "frontend-ui",
      "command": "npm run dev",
      "args": ["npm", "run", "dev"],
      "binary_requires": ["node", "npm"],
      "npm_deps": true,
      "is_admin_only": false,
      "auto_start": false,
      "wait_time": 14,
      "startup_order_hint": 20,
      "depends_on": ["api"],
      "tags": ["Frontend", "Vite"]
    },
    "operator-server": {
      "name": "MOX 编排器",
      "port": 3001,
      "health_check": "/mox-viz/api/health",
      "cwd": ".",
      "command": "target/debug/operator-server.exe",
      "args": ["target/debug/operator-server.exe", "--port", "3001"],
      "binary_requires": [],
      "npm_deps": false,
      "is_admin_only": true,
      "auto_start": false,
      "wait_time": 8,
      "startup_order_hint": 15,
      "depends_on": [],
      "tags": ["Orchestrator", "Rust"]
    },
    "mox-alliance-scheduler": {
      "name": "联盟调度器",
      "port": 3100,
      "health_check": "/health",
      "cwd": ".",
      "command": "target/debug/mox-alliance-scheduler.exe",
      "args": ["target/debug/mox-alliance-scheduler.exe", "--port", "3100"],
      "binary_requires": [],
      "npm_deps": false,
      "is_admin_only": false,
      "auto_start": false,
      "wait_time": 8,
      "startup_order_hint": 25,
      "depends_on": [],
      "tags": ["Alliance", "Scheduler", "Rust"]
    },
    "mox-alliance-executor": {
      "name": "联盟执行器",
      "port": 3200,
      "health_check": "/health",
      "cwd": ".",
      "command": "target/debug/mox-alliance-executor.exe",
      "args": ["target/debug/mox-alliance-executor.exe", "--port", "3200"],
      "binary_requires": [],
      "npm_deps": false,
      "is_admin_only": false,
      "auto_start": false,
      "wait_time": 8,
      "startup_order_hint": 30,
      "depends_on": ["mox-alliance-scheduler"],
      "tags": ["Alliance", "Executor", "Rust"]
    },
    "xiaobai_voice": {
      "name": "小白语音插件",
      "port": 30010,
      "health_check": "/voice/health",
      "cwd": "projects/xiaobai_voice",
      "command": "python -m xiaobai_voice serve --host 0.0.0.0",
      "args": ["python", "-m", "xiaobai_voice", "serve", "--host", "0.0.0.0"],
      "binary_requires": ["python"],
      "npm_deps": false,
      "is_admin_only": false,
      "auto_start": false,
      "wait_time": 12,
      "startup_order_hint": 40,
      "depends_on": [],
      "tags": ["Plugin", "Voice"]
    }
  },
  "project_registry": {},
  "script_catalog": {}
}
