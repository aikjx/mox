//! 妗岄潰灏忕櫧鍔╂墜 路 浜岃繘鍒跺叆鍙ｏ紙Rust 鍏ㄦ爤 路 WebView2 3D 鎮诞鐞冿級
//!
//! 褰㈡€侊細鏃犺竟妗嗛€忔槑缃《鎮诞鐞冿紙WebGL2 娲讳綋鎷撴墤鍑犱綍鐞冿級锛?
//!   - 鐐瑰嚮鎮诞鐞?鈫?灞曞紑瀵硅瘽闈㈡澘锛屽揩閫熸枃鏈璇濓紙8 绫荤畻瀛愭湰鍦版墽琛岋級
//!   - 鎸変綇鎷栧姩 鈫?绉诲姩鎮诞鐞?
//!   - 鍏ㄥ眬鐑敭锛欰lt+X 褰曢煶寮€鍏筹紙Listen 鐘舵€侊級/ Alt+Q 闅愯棌鏄剧ず
//!   - 鍚庡彴鍚姩 voice_proxy :3717锛屼緵 Rust 缃戝叧 /voice/** 浠ｇ悊
//!
//! ```bash
//! # GUI锛堥粯璁わ級
//! cargo run -p xiaobai-desktop
//! # 涓€娆℃€ф墽琛岋細鏂囧瓧绔埌绔紙headless 璋冭瘯锛?
//! cargo run -p xiaobai-desktop -- --once "闊抽噺鐘舵€?
//! # REPL 浜や簰妯″紡
//! cargo run -p xiaobai-desktop -- --repl
//! ```

use std::sync::Arc;

use clap::Parser;
use serde_json::json;
use tracing_subscriber::EnvFilter;

use mox_voice_desktop_app::{ball_widget::BallWidgetState, global_hotkeys::HotkeyAction};

use tao::{
    dpi::LogicalSize,
    event::{Event, WindowEvent},
    event_loop::{ControlFlow, EventLoopBuilder, EventLoopProxy},
};

// =============================== 绐楀彛灏哄 ===============================
const BALL_W: f64 = 150.0;
const BALL_H: f64 = 150.0;
const PANEL_W: f64 = 470.0;
const PANEL_H: f64 = 690.0;

// =============================== 鐢ㄦ埛浜嬩欢 ===============================
enum UserEvent {
    /// JS 鈫?Rust 鐨勫師濮?IPC 娑堟伅
    Ipc(String),
    /// 瀵硅瘽 dispatch 缁撴灉锛圝SON 瀛楃涓诧級
    ChatResult(String),
    /// 鐘舵€佹帹閫侊紙BallWidgetState repr u8锛?
    SetState(u8),
    /// 鐑敭锛氬綍闊冲紑鍏?
    ToggleRecord,
    /// 鐑敭锛氶殣钘?鏄剧ず鎮诞鐞?
    ToggleWidget,
    /// 鎮诞鐞?toast 鎻愮ず
    Toast(String),
}

// =============================== CLI ===============================
#[derive(Debug, Clone, Parser)]
#[command(
    name = "xiaobai-desktop",
    version,
    about = "馃殌 妗岄潰灏忕櫧鍔╂墜 路 Rust 鍏ㄦ爤 3D 鎮诞鐞?+ voice_proxy 3717 + 8 澶х被绠楀瓙锛團R-13锛?,
)]
struct Args {
    /// 榛樿鐢ㄦ埛 id锛圧BAC L0~L3锛?
    #[arg(long, default_value = "desktop_user_001")]
    user_id: String,
    /// 榛樿瑙掕壊
    #[arg(long, default_value = "member")]
    role: String,
    /// 涓€娆℃€ф墽琛岋細鏂囨湰 鈫?鎵ц 鈫?鎵撳嵃 JSON 鈫?閫€鍑猴紙headless锛?
    #[arg(long)]
    once: Option<String>,
    /// REPL 浜や簰妯″紡锛坔eadless锛?
    #[arg(long)]
    repl: bool,
    /// 璇煶 TTS 鍚堟垚锛氬悎鎴愭枃鏈负 WAV 杈撳嚭鍒?--out锛坔eadless锛?
    #[arg(long)]
    tts: Option<String>,
    /// 璇煶閾捐矾娴嬭瘯锛氬綍闊?N 绉?鈫?ASR 杞啓 鈫?鎵撳嵃鏂囨湰锛坔eadless锛?
    #[arg(long)]
    vtest: bool,
    /// --vtest 褰曢煶鏃堕暱锛堢锛?
    #[arg(long, default_value_t = 3.0)]
    vsecs: f64,
    /// 杈撳嚭 WAV 璺緞锛?-tts / --vtest 鐢級
    #[arg(long, default_value = "voice_out.wav")]
    out: String,
    /// 涓?spawn :3717 HTTP 鏈嶅姟
    #[arg(long)]
    no_server: bool,
}

// =============================== 瀵硅瘽鍒嗗彂锛堢嚎绋嬪唴锛?===============================
/// 浠?dispatch_text 鐨?JSON 缁撴灉涓彁鍙栧彲鏈楄鏂囨湰銆?
fn extract_speak_text(v: &serde_json::Value) -> String {
    // 1) execution.output锛堝彲鑳芥槸 string / {output|text} / array锛?
    if let Some(exec) = v.get("execution") {
        if let Some(out) = exec.get("output") {
            if let Some(s) = out.as_str() {
                if !s.trim().is_empty() {
                    return s.trim().to_string();
                }
            }
            // 瀵硅薄锛氬彇 output / text / message
            if let Some(s) = out
                .get("output")
                .or_else(|| out.get("text"))
                .and_then(|x| x.as_str())
            {
                if !s.trim().is_empty() {
                    return s.trim().to_string();
                }
            }
        }
    }
    // 2) error.message
    if let Some(msg) = v.pointer("/error/message").and_then(|m| m.as_str()) {
        if !msg.trim().is_empty() {
            return msg.trim().to_string();
        }
    }
    // 3) 椤跺眰 message / text
    if let Some(s) = v.get("message").or_else(|| v.get("text")).and_then(|x| x.as_str()) {
        if !s.trim().is_empty() {
            return s.trim().to_string();
        }
    }
    v.to_string()
}

/// headless锛氭枃鏈?鈫?dispatch 鈫?鎻愬彇鍥炵瓟 鈫?TTS 鍚堟垚 WAV
fn run_tts_pipeline(
    text: String,
    out_path: &str,
) -> anyhow::Result<()> {
    let models = mox_voice_desktop_app::voice_engine::locate_models_dir()
        .ok_or_else(|| anyhow::anyhow!("鏈壘鍒拌闊虫ā鍨嬬洰褰曪紙models/voice锛夈€?))?;
    let engine = mox_voice_desktop_app::VoiceEngine::new(&models)?;
    tracing::info!(target: "xiaobai_voice", "妯″瀷灏辩华锛欰SR+TTS锛岃璇濅汉 sid={}", engine.speaker_count());

    let rt = tokio::runtime::Builder::new_current_thread()
        .enable_all()
        .build()?;
    let answer = rt.block_on(async {
        use mox_voice_operator_svc::server_3717::{VoiceServiceConfig, XiaobaiVoiceService};
        let svc = XiaobaiVoiceService::new(VoiceServiceConfig::default())?;
        let v = svc.dispatch_text(&text, None, None).await?;
        Ok::<String, anyhow::Error>(extract_speak_text(&v))
    })?;

    let t0 = std::time::Instant::now();
    let sr = engine.synthesize_to_wav(&answer, std::path::Path::new(out_path))?;
    tracing::info!(target: "xiaobai_voice", "TTS 鍚堟垚瀹屾垚锛歿out_path}锛坽}s 璇嗗埆鏂囨湰={answer:?}锛?, t0.elapsed().as_secs_f32());
    println!("{}", serde_json::json!({
        "input_text": text,
        "answer": answer,
        "wav": out_path,
        "sample_rate": sr,
        "elapsed_s": t0.elapsed().as_secs_f32(),
    }));
    Ok(())
}

/// headless锛氬綍闊?N 绉?鈫?ASR 杞啓 鈫?鎵撳嵃鏂囨湰锛堝彲閫?dispatch + 鍚堟垚锛?
fn run_voice_test(secs: f64, out_path: &str) -> anyhow::Result<()> {
    let models = mox_voice_desktop_app::voice_engine::locate_models_dir()
        .ok_or_else(|| anyhow::anyhow!("鏈壘鍒拌闊虫ā鍨嬬洰褰曪紙models/voice锛夈€?))?;
    let engine = mox_voice_desktop_app::VoiceEngine::new(&models)?;

    println!("馃帣 寮€濮嬪綍闊?{secs}s 鈥︼紙璇峰鐫€楹﹀厠椋庤璇濓級");
    let rec = mox_voice_desktop_app::Recorder::start()?;
    std::thread::sleep(std::time::Duration::from_secs_f64(secs));
    let pcm = rec.stop(16000);
    let peak = mox_voice_desktop_app::voice_engine::peak_level(&pcm);
    println!("褰曢煶缁撴潫锛歿} 鏍锋湰锛屽嘲鍊?{:.3}", pcm.len(), peak);
    if mox_voice_desktop_app::voice_engine::is_silent(&pcm, 0.01) {
        anyhow::bail!("褰曢煶鍩烘湰涓洪潤闊筹紙宄板€?{peak:.3} < 0.01锛夛紝璇锋鏌ラ害鍏嬮");
    }

    let t0 = std::time::Instant::now();
    let text = engine.recognize(&pcm);
    println!("[ASR] 璇嗗埆缁撴灉锛坽}ms锛夛細{:?}", t0.elapsed().as_millis(), text);
    if text.is_empty() {
        anyhow::bail!("ASR 鏈瘑鍒埌鏂囨湰");
    }

    // 鍚堟垚娴嬭瘯锛堣鍥炶瘑鍒枃鏈紝楠岃瘉 TTS 闂幆锛?
    let sr = engine.synthesize_to_wav(&text, std::path::Path::new(out_path))?;
    println!("[TTS] 宸插悎鎴?{out_path}锛坰r={sr}锛?);
    println!("{}", serde_json::json!({
        "asr_text": text,
        "peak": peak,
        "wav": out_path,
        "sample_rate": sr,
        "asr_elapsed_ms": t0.elapsed().as_millis(),
    }));
    Ok(())
}

/// 鍦ㄧ嫭绔嬬嚎绋嬫墽琛屼竴娆℃枃鏈垎鍙戯紝鍏抽敭鑺傜偣鍚戜富绾跨▼鎺ㄩ€佺姸鎬併€?
fn run_dispatch(
    text: String,
    proxy: EventLoopProxy<UserEvent>,
    state: Arc<mox_voice_desktop_app::ball_widget::StateController>,
) {
    std::thread::spawn(move || {
        state.transition(BallWidgetState::Think);
        let _ = proxy.send_event(UserEvent::SetState(BallWidgetState::Think as u8));
        let rt = tokio::runtime::Builder::new_current_thread()
            .enable_all()
            .build();
        let json = match rt {
            Ok(rt) => {
                let fut = async {
                    use mox_voice_operator_svc::server_3717::{VoiceServiceConfig, XiaobaiVoiceService};
                    let svc = XiaobaiVoiceService::new(VoiceServiceConfig::default())?;
                    svc.dispatch_text(&text, None, None).await
                };
                match rt.block_on(fut) {
                    Ok(v) => {
                        let exec_ok = v
                            .get("execution")
                            .and_then(|e| e.get("ok"))
                            .and_then(|o| o.as_bool())
                            .unwrap_or(false);
                        if exec_ok {
                            state.transition(BallWidgetState::Executing);
                            let _ = proxy.send_event(UserEvent::SetState(BallWidgetState::Executing as u8));
                        }
                        v.to_string()
                    }
                    Err(e) => json!({ "error": { "message": e.to_string() } }).to_string(),
                }
            }
            Err(e) => json!({ "error": { "message": format!("tokio 鍒濆鍖栧け璐? {e}") } }).to_string(),
        };
        let _ = proxy.send_event(UserEvent::ChatResult(json));
        state.transition(BallWidgetState::Idle);
        let _ = proxy.send_event(UserEvent::SetState(BallWidgetState::Idle as u8));
    });
}

/// 璇煶闂幆锛歱cm 鈫?Paraformer ASR 鈫?dispatch_text 鈫?鍥炵瓟 鈫?Kokoro TTS 鈫?鎾斁銆?
/// 鍚庡彴绾跨▼鎵ц锛岀姸鎬侀€氳繃 proxy 鍥炰紶涓荤嚎绋嬨€?
fn run_voice_loop(
    engine: Arc<mox_voice_desktop_app::VoiceEngine>,
    pcm: Vec<i16>,
    proxy: EventLoopProxy<UserEvent>,
    state: Arc<mox_voice_desktop_app::ball_widget::StateController>,
) {
    std::thread::spawn(move || {
        // ---- 1. ASR ----
        state.transition(BallWidgetState::Think);
        let _ = proxy.send_event(UserEvent::SetState(BallWidgetState::Think as u8));
        let text = engine.recognize(&pcm);
        if text.trim().is_empty() {
            state.transition(BallWidgetState::Idle);
            let _ = proxy.send_event(UserEvent::SetState(0));
            let _ = proxy.send_event(UserEvent::Toast("鏈瘑鍒埌璇煶锛岃鍐嶈瘯涓€娆?.into()));
            return;
        }

        // ---- 2. dispatch锛堟湰鍦扮畻瀛愭墽琛岋級 ----
        let rt = tokio::runtime::Builder::new_current_thread()
            .enable_all()
            .build();
        let json = match rt {
            Ok(rt) => {
                let fut = async {
                    use mox_voice_operator_svc::server_3717::{VoiceServiceConfig, XiaobaiVoiceService};
                    let svc = XiaobaiVoiceService::new(VoiceServiceConfig::default())?;
                    svc.dispatch_text(&text, None, None).await
                };
                match rt.block_on(fut) {
                    Ok(v) => {
                        let exec_ok = v
                            .get("execution")
                            .and_then(|e| e.get("ok"))
                            .and_then(|o| o.as_bool())
                            .unwrap_or(false);
                        if exec_ok {
                            state.transition(BallWidgetState::Executing);
                            let _ = proxy.send_event(UserEvent::SetState(BallWidgetState::Executing as u8));
                        }
                        v
                    }
                    Err(e) => json!({ "error": { "message": e.to_string() } }),
                }
            }
            Err(e) => json!({ "error": { "message": format!("tokio 鍒濆鍖栧け璐? {e}") } }),
        };

        let speak_text = extract_speak_text(&json);
        let _ = proxy.send_event(UserEvent::ChatResult(json.to_string()));

        // ---- 3. TTS 鏈楄 ----
        if !speak_text.trim().is_empty() {
            state.transition(BallWidgetState::Speak);
            let _ = proxy.send_event(UserEvent::SetState(BallWidgetState::Speak as u8));
            if let Err(e) = engine.speak(&speak_text) {
                tracing::warn!(target: "xiaobai_voice", "TTS 鏈楄澶辫触: {e:#}");
                let _ = proxy.send_event(UserEvent::Toast(format!("鏈楄澶辫触: {e}")));
            }
        }

        state.transition(BallWidgetState::Idle);
        let _ = proxy.send_event(UserEvent::SetState(BallWidgetState::Idle as u8));
    });
}

// =============================== GUI 涓诲叆鍙?===============================
fn run_gui(args: Args) -> anyhow::Result<()> {
    let event_loop = EventLoopBuilder::<UserEvent>::with_user_event().build();
    let proxy = event_loop.create_proxy();

    // ---- 鎮诞鐞冪獥鍙ｏ細鏃犺竟妗?路 閫忔槑 路 缃《 ----
    let mut wb = tao::window::WindowBuilder::new()
        .with_title("灏忕櫧 路 鐠囩帒浼欎即")
        .with_inner_size(LogicalSize::new(BALL_W, BALL_H))
        .with_decorations(false)
        .with_transparent(true)
        .with_always_on_top(true)
        .with_resizable(false);
    #[cfg(target_os = "windows")]
    {
        use tao::platform::windows::WindowBuilderExtWindows;
        wb = wb.with_undecorated_shadow(false);
    }
    let window = Arc::new(wb.build(&event_loop)?);

    // ---- WebView锛氬姞杞?3D 鎮诞鐞?UI ----
    let html = include_str!("../ui/index.html");
    let ipc_proxy = proxy.clone();
    let builder = wry::WebViewBuilder::new()
        .with_transparent(true)
        .with_html(html)
        .with_ipc_handler(move |req: wry::http::Request<String>| {
            let body = req.body().clone();
            let _ = ipc_proxy.send_event(UserEvent::Ipc(body));
        });
    let webview = builder.build(&window)?;

    // ---- 鍏ㄥ眬鐑敭 ----
    let state = Arc::new(mox_voice_desktop_app::ball_widget::StateController::new());
    let hk_manager = global_hotkey::GlobalHotKeyManager::new().ok();
    let mut hotkeys: Vec<(global_hotkey::hotkey::HotKey, HotkeyAction)> = Vec::new();
    if let Some(mgr) = &hk_manager {
        use global_hotkey::hotkey::HotKey;
        let binds = mox_voice_desktop_app::global_hotkeys::HotkeyBindings::with_defaults();
        for (action, combo) in &binds.bindings {
            let parsed = parse_combo(combo);
            if let Some((code, mods)) = parsed {
                let hk = HotKey::new(Some(mods), code);
                if mgr.register(hk).is_ok() {
                    hotkeys.push((hk, *action));
                }
            }
        }
    }

    // 鍒濆鎺ㄩ€佺姸鎬?
    let _ = webview.evaluate_script("window.__setState(0)");

    // ---- P2 璇煶寮曟搸锛堝惎鍔ㄦ椂鍔犺浇涓€娆★紱妯″瀷缂哄け鍒欏綍闊虫椂鎻愮ず锛?---
    let engine = match mox_voice_desktop_app::voice_engine::locate_models_dir() {
        Some(dir) => match mox_voice_desktop_app::VoiceEngine::new(&dir) {
            Ok(e) => {
                tracing::info!(target: "xiaobai_voice", "璇煶寮曟搸灏辩华锛堟ā鍨? {dir:?}锛岃璇濅汉 {}锛?, e.speaker_count());
                Some(Arc::new(e))
            }
            Err(e) => {
                tracing::warn!(target: "xiaobai_voice", "璇煶寮曟搸鍒濆鍖栧け璐? {e:#}锛圓lt+X 灏嗗洖閫€鏃у崰浣嶏級");
                let _ = webview.evaluate_script("window.__toast('璇煶寮曟搸鏈姞杞斤紝Alt+X 鏆備笉鍙敤')");
                None
            }
        },
        None => {
            tracing::warn!(target: "xiaobai_voice", "鏈壘鍒拌闊虫ā鍨嬬洰褰曪紝璇煶闂幆绂佺敤");
            let _ = webview.evaluate_script("window.__toast('鏈壘鍒拌闊虫ā鍨嬶紝Alt+X 鏆備笉鍙敤')");
            None
        }
    };

    // ---- 浜嬩欢寰幆 ----
    let mut widget_visible = true;
    let mut recording: Option<mox_voice_desktop_app::Recorder> = None;

    event_loop.run(move |event, _el, control_flow| {
        *control_flow = ControlFlow::Wait;

        // 鍏ㄥ眬鐑敭浜嬩欢
        if let Ok(ev) = global_hotkey::GlobalHotKeyEvent::receiver().try_recv() {
            if ev.state() == global_hotkey::HotKeyState::Pressed {
                for (hk, action) in &hotkeys {
                    if hk.id() == ev.id() {
                        match action {
                            HotkeyAction::ToggleRecord => {
                                let _ = proxy.send_event(UserEvent::ToggleRecord);
                            }
                            HotkeyAction::ToggleWidgetVisible => {
                                let _ = proxy.send_event(UserEvent::ToggleWidget);
                            }
                            _ => {}
                        }
                    }
                }
            }
        }

        match event {
            Event::WindowEvent {
                event: WindowEvent::CloseRequested,
                ..
            } => *control_flow = ControlFlow::Exit,

            Event::UserEvent(ev) => match ev {
                UserEvent::Ipc(msg) => {
                    if let Some(rest) = msg.strip_prefix("chat:") {
                        run_dispatch(rest.to_string(), proxy.clone(), state.clone());
                    } else {
                        match msg.as_str() {
                            "open-panel" => {
                                let _ = window.set_inner_size(LogicalSize::new(PANEL_W, PANEL_H));
                            }
                            "close-panel" => {
                                let _ = window.set_inner_size(LogicalSize::new(BALL_W, BALL_H));
                            }
                            "drag" => {
                                let _ = window.drag_window();
                            }
                            "ready" => {
                                let _ = webview
                                    .evaluate_script("window.__setState(0)");
                            }
                            _ => {}
                        }
                    }
                }
                UserEvent::ChatResult(json_str) => {
                    let _ = webview
                        .evaluate_script(&format!("window.__chatResponse({json_str:?})"));
                }
                UserEvent::SetState(n) => {
                    let _ = webview.evaluate_script(&format!("window.__setState({n})"));
                }
                UserEvent::ToggleRecord => {
                    // P2 鐪熷疄闂幆锛氶鎸夊紑濮嬪綍闊筹紙Listen锛夛紝鍐嶆寜鍋滄 鈫?ASR 鈫?dispatch 鈫?TTS
                    if recording.is_none() {
                        match mox_voice_desktop_app::Recorder::start() {
                            Ok(rec) => {
                                recording = Some(rec);
                                state.transition(BallWidgetState::Listen);
                                let _ = webview.evaluate_script("window.__setState(1)");
                                let _ = webview.evaluate_script("window.__toast('馃帣 褰曢煶涓€?鍐嶆寜 Alt+X 缁撴潫')");
                            }
                            Err(e) => {
                                let _ = webview
                                    .evaluate_script(&format!("window.__toast('褰曢煶璁惧涓嶅彲鐢? {e}')"));
                            }
                        }
                    } else {
                        let rec = recording.take().unwrap();
                        let pcm = rec.stop(16000);
                        let peak = mox_voice_desktop_app::voice_engine::peak_level(&pcm);
                        if pcm.is_empty() || mox_voice_desktop_app::voice_engine::is_silent(&pcm, 0.01) {
                            state.transition(BallWidgetState::Idle);
                            let _ = webview.evaluate_script("window.__setState(0)");
                            let _ = webview.evaluate_script(&format!(
                                "window.__toast('鏈惉鍒板０闊筹紙宄板€?{peak:.2}锛夛紝璇峰啀璇?)"
                            ));
                        }
                        match &engine {
                            Some(eng) => {
                                let eng = eng.clone();
                                run_voice_loop(eng, pcm, proxy.clone(), state.clone());
                            }
                            None => {
                                state.transition(BallWidgetState::Idle);
                                let _ = webview.evaluate_script("window.__setState(0)");
                                let _ = webview.evaluate_script("window.__toast('璇煶寮曟搸鏈姞杞?)");
                            }
                        }
                    }
                }
                UserEvent::ToggleWidget => {
                    widget_visible = !widget_visible;
                    window.set_visible(widget_visible);
                }
                UserEvent::Toast(msg) => {
                    let _ = webview.evaluate_script(&format!("window.__toast({msg:?})"));
                }
            },

            _ => {}
        }
    });
}

// =============================== 鐑敭缁勫悎瑙ｆ瀽 ===============================
fn parse_combo(
    combo: &str,
) -> Option<(
    global_hotkey::hotkey::Code,
    global_hotkey::hotkey::Modifiers,
)> {
    use global_hotkey::hotkey::{Code, Modifiers};
    let parts: Vec<&str> = combo.split('+').map(|s| s.trim()).collect();
    let mut mods = Modifiers::empty();
    let mut code = None;
    for p in parts {
        match p.to_ascii_lowercase().as_str() {
            "alt" => mods.insert(Modifiers::ALT),
            "ctrl" | "control" => mods.insert(Modifiers::CONTROL),
            "shift" => mods.insert(Modifiers::SHIFT),
            "meta" | "win" | "super" => mods.insert(Modifiers::META),
            "x" => code = Some(Code::KeyX),
            "q" => code = Some(Code::KeyQ),
            "s" => code = Some(Code::KeyS),
            _ => {}
        }
    }
    code.map(|c| (c, mods))
}

// =============================== headless 璋冭瘯 ===============================
async fn run_once_debug(text: &str) -> Result<serde_json::Value, mox_voice_core_svc::errors::XiaobaiError> {
    use mox_voice_operator_svc::server_3717::{VoiceServiceConfig, XiaobaiVoiceService};
    let svc = XiaobaiVoiceService::new(VoiceServiceConfig::default())?;
    svc.dispatch_text(text, None, None).await
}

// =============================== main ===============================
#[tokio::main]
async fn main() -> anyhow::Result<()> {
    tracing_subscriber::fmt()
        .with_env_filter(
            EnvFilter::try_from_default_env()
                .unwrap_or_else(|_| EnvFilter::new("info,xiaobai_audit=info,warn")),
        )
        .with_target(false)
        .init();

    let args = Args::parse();

    // headless锛歍TS 鍚堟垚
    if let Some(text) = args.tts {
        return run_tts_pipeline(text, &args.out);
    }
    // headless锛氬綍闊?鈫?ASR 閾捐矾
    if args.vtest {
        return run_voice_test(args.vsecs, &args.out);
    }

    // headless 璋冭瘯妯″紡
    if let Some(text) = args.once {
        let t0 = std::time::Instant::now();
        match run_once_debug(&text).await {
            Ok(v) => {
                println!("{}", serde_json::to_string_pretty(&v)?);
                println!("elapsed: {:?}", t0.elapsed());
            }
            Err(e) => eprintln!("XB 閿欒: {e:#}"),
        }
        return Ok(());
    }
    if args.repl {
        println!("馃挰 REPL 妯″紡锛坔eadless锛夛細杈撳叆涓€琛屾墽琛岋紝绌鸿閫€鍑恒€?);
        use std::io::BufRead;
        let stdin = std::io::stdin();
        for line in stdin.lock().lines() {
            let l = line?.trim().to_string();
            if l.is_empty() {
                break;
            }
            match run_once_debug(&l).await {
                Ok(v) => println!("{}", v),
                Err(e) => eprintln!("XB 閿欒: {e:#}"),
            }
        }
        return Ok(());
    }

    // GUI 榛樿锛氬厛鐢ㄤ富 tokio runtime 鍚庡彴鍚姩 voice_proxy :3717锛堜緵 Rust 缃戝叧 /voice/** 浠ｇ悊锛?
    if !args.no_server {
        let cfg = mox_voice_operator_svc::server_3717::VoiceServiceConfig::default();
        let addr = cfg.bind.to_string();
        tokio::spawn(async move {
            if let Err(e) = mox_voice_operator_svc::server_3717::serve(cfg).await {
                eprintln!("voice 3717 鏈嶅姟寮傚父閫€鍑? {e:#}");
            }
        });
        tracing::info!(target: "xiaobai_cli", "voice_proxy :3717 鍚庡彴鍚姩 鈫?{addr}");
    }

    run_gui(args)
}

